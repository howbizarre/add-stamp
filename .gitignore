# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# wrangler files
.wrangler
.dev.vars*

# WASM build outputs
wasm/pkg/
wasm/target/

# The artifact, written by packages/image-stamper/scripts/build.mjs; the app consumes the
# published package instead. The package's dist/ is covered by the dist rule above.
packages/image-stamper/wasm/

# Rust/Cargo files
# wasm/Cargo.lock is deliberately committed: the crate is a deployed application artifact,
# not a library, and the wasm-bindgen crate version must match the wasm-bindgen-cli that
# wasm-pack invokes. Without the lock file that pair drifts and the build breaks.

# Generated TypeScript declarations
*.d.ts
!env.d.ts
!worker-configuration.d.ts

# Editor and IDE files
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~

# OS generated files
Thumbs.db
ehthumbs.db

# Temporary files
*.tmp
*.temp
